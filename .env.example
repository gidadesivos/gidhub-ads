# Copie para .env e preencha com os valores reais. Nunca commite o .env.

# Postgres do Supabase — conexão via pooler (pgbouncer), usada em runtime.
# Painel do Supabase: Project Settings > Database > Connection string > "Transaction" (porta 6543).
# Adicione ?pgbouncer=true no final da URL.
DATABASE_URL="postgresql://postgres.xxxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432) — usada só por `prisma generate`/`migrate`/`db push`, nunca em runtime.
# Painel do Supabase: Project Settings > Database > Connection string > "Session" ou "URI".
DIRECT_URL="postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres"

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor aleatório forte,
# por exemplo com: openssl rand -base64 32
SESSION_SECRET="troque-por-um-segredo-forte-e-aleatorio"

# Supabase — chaves públicas (client-side). Seguras para expor no navegador.
# Painel do Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
